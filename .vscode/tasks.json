
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar y ejecutar Juego de la Vida",
            "type": "shell",
            "command": "gcc src/main.c src/front.c -o juego.exe $(pkg-config --cflags --libs allegro-5 allegro_primitives-5) && ./juego.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "MSYSTEM": "UCRT64",
                    "CHERE_INVOKING": "1"
                },
                "shell": {
                    "executable": "C:\\msys64\\usr\\bin\\bash.exe",
                    "args": ["--login", "-c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
